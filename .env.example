# --- Backend Lambdas -----------------------------------------------------
# LlamaGet
BUCKET_NAME=your-upload-bucket
TABLE_NAME=LensSessions
# Optional: how long a presigned PUT URL stays valid (default 3600s)
# PRESIGN_EXPIRES_SECONDS=3600

# LlamaParse + LlamaQuery + LlamaStatus
SESSIONS_TABLE=LensSessions
CHUNKS_TABLE=LensChunks
OPENAI_API_KEY=sk-xxx
# Optional model + tuning overrides
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# DEFAULT_TOP_K=5
# LLM_MAX_TOKENS=600

# AWS_REGION=us-east-1

# --- Frontend (Create React App) -----------------------------------------
# REACT_APP_API_BASE=https://<api-id>.execute-api.<region>.amazonaws.com/prod
